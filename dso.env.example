# dso server configuration.
#
# Copy to dso.env and edit. The server loads dso.env automatically at startup;
# DSO_ENV_FILE=other.env picks a different one.
#
# Real environment variables always win over this file, so a one-off override
# still works without editing anything:
#
#     DSO_CALIBRATION_VERSION=0107 ./dsoserver

# --- network -----------------------------------------------------------------

# The address handed to clients. Must be the LAN IP the console can reach, NOT
# 127.0.0.1: it is written into the login reply and the auth GameServerInfo, and
# a wrong value produces a client that authenticates fine and then never sends.
DSO_SERVER_ADVERTISE_ADDRESS=192.168.1.100

# DNS redirect for real consoles (point the PS3's DNS at this machine). Not
# needed under RPCS3 if you use its IP/Hosts switch instead -- note RPCS3 splits
# that setting on '&&', not '&':
#   frpg2-ps3-ope.fromsoftware.jp=192.168.1.100&&frpg2-ps3-internal.s3-website-us-west-2.amazonaws.com=192.168.1.100
DSO_DNS=1

# Ports 53 and 80 need privilege. On WSL this resets every restart:
#   sudo sysctl -w net.ipv4.ip_unprivileged_port_start=53
DSO_BOOTSTRAP_HTTP=1

# --- calibration -------------------------------------------------------------

# Directory holding contents_NNNN.bin and regulation_NNNN.bin.
DSO_BOOTSTRAP_CALIBRATION_DIR=data/calibrations

# Which calibration the client actually receives.
#
# The EBOOT hardcodes the contents_0101.bin URL, so a client can only ever ask
# for 0101; this answers that request with another version's manifest, and the
# client follows it to the matching regulation on its own.
#
# Empty = serve exactly what was asked for (no update, since the disc already
# satisfies 0101).
#
# Published versions and dates:
#   0101  2014-01-26     0110  2014-07-08
#   0104  2014-01-31     0111  2014-08-11
#   0107  2014-06-02     0112  2014-09-09
#   0108  2014-06-02     0113  2014-10-07
#   0109  2014-06-05     0114  2015-04-01
#
# CAUTION: a calibration expects a matching game build. 0114 crashed RPCS3 on a
# BLUS41045_v01.00 (launch disc, no title update) install. Walk forward from the
# oldest and stop at the last one that boots.
DSO_CALIBRATION_VERSION=

# --- server text -------------------------------------------------------------

# Pushed as the banner in the UPPER LEFT right after login. Empty disables it.
# This is NOT the Majula obelisk -- that text lives in the regulation archive.
DSO_MANAGEMENT_TEXT=
# 0 = Japanese, 1 = English.
DSO_MANAGEMENT_TEXT_LANGUAGE=1

# --- storage and logging -----------------------------------------------------

DSO_CRYPTO_KEY_DIR=data/keys
DSO_DATABASE_PATH=data/dso.db
DSO_LOGGING_LEVEL=debug

# Hexdumps every packet. Invaluable for protocol work, very noisy otherwise.
DSO_DEBUG_RAW=1

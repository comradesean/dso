# dso server configuration.
#
# Copy to dso.env and edit. The server loads dso.env automatically at startup;
# DSO_ENV_FILE=other.env picks a different one.
#
# Real environment variables always win over this file, so a one-off override
# still works without editing anything:
#
#     DSO_CALIBRATION_VERSION=0107 ./dsoserver

# --- network -----------------------------------------------------------------

# The address handed to clients. Must be the LAN IP the console can reach, NOT
# 127.0.0.1: it is written into the login reply and the auth GameServerInfo, and
# a wrong value produces a client that authenticates fine and then never sends.
DSO_SERVER_ADVERTISE_ADDRESS=192.168.1.100

# DNS redirect for real consoles (point the PS3's DNS at this machine). Not
# needed under RPCS3 if you use its IP/Hosts switch instead -- note RPCS3 splits
# that setting on '&&', not '&':
#   frpg2-ps3-ope.fromsoftware.jp=192.168.1.100&&frpg2-ps3-internal.s3-website-us-west-2.amazonaws.com=192.168.1.100
DSO_DNS=1

# Ports 53 and 80 need privilege. On WSL this resets every restart:
#   sudo sysctl -w net.ipv4.ip_unprivileged_port_start=53
DSO_BOOTSTRAP_HTTP=1

# --- calibration -------------------------------------------------------------

# Directory holding contents_NNNN.bin and regulation_NNNN.bin.
DSO_BOOTSTRAP_CALIBRATION_DIR=data/calibrations

# Which calibration the client actually receives.
#
# The EBOOT hardcodes the contents_0101.bin URL, so a client can only ever ask
# for 0101; this answers that request with another version's manifest, and the
# client follows it to the matching regulation on its own.
#
# Empty = serve exactly what was asked for (no update, since the disc already
# satisfies 0101).
#
# Published versions and dates:
#   0101  2014-01-26     0110  2014-07-08
#   0104  2014-01-31     0111  2014-08-11
#   0107  2014-06-02     0112  2014-09-09
#   0108  2014-06-02     0113  2014-10-07
#   0109  2014-06-05     0114  2015-04-01
#
# CAUTION: a calibration expects a matching game build. 0114 crashed RPCS3 on a
# BLUS41045_v01.00 (launch disc, no title update) install. Walk forward from the
# oldest and stop at the last one that boots.
DSO_CALIBRATION_VERSION=

# Introduce two players who are both sitting in an arena queue, rather than
# waiting for one of them to search.
#
# The client alternates between advertising and searching, and only searches when
# the player interacts with the statue -- so two queued players can sit there with
# neither looking. This sends a join neither client asked for. Both have already
# declared availability by registering and the receiver still chooses whether to
# allow, but whether the far side accepts an unsolicited allow is UNVERIFIED.
DSO_QUICKMATCH_AUTOPAIR=0

# --- matchmaking -------------------------------------------------------------

# Filter target lists by soul memory band, covenant pool and activity area,
# rather than offering every online player to everyone. Read out of the
# AllStatus blob the client uploads on its status heartbeat.
#
# Defaults ON, because an unfiltered list is not a safe fallback -- it is the
# bug. With it off, an ineligible target is re-offered on every one of the
# client's ~20.5s auto-summon polls, which reads in game as "summoning failed"
# every twenty seconds for as long as the crest stays equipped.
#
# Set to 0 if summons stop finding anyone. The soul memory tier table and the
# belfry/rat area cell ids are the two pieces here NOT verified against the PS3
# client, so they are the first suspects if this filters too aggressively.
DSO_MATCHMAKING_FILTERS=1

# Relay a belfry bell toll (0x03EE) to every other connected player as
# PushRequestNotifyRingBell (0x03EF). This is what makes a bell audible to people
# who are not in the belfry, and is the mechanism behind the long-standing
# reports of hearing bells with no invasion of one's own underway.
#
# CONFIRMED WORKING in game: a player outside the belfry, not in the session,
# heard the bell when this was sent, with every other client muted at the OS
# level. Defaults ON. Set to 0 to silence it.
#
# Note this refuted a careful decompilation result which held that the client
# discards 0x03EF before parsing, because the listener it checks appeared never
# to be assigned anywhere in the executable. It is assigned; the analysis simply
# could not find the store.
DSO_BELL_BROADCAST=1

# Send a synthetic toll every N seconds with nobody ringing anything, to test the
# receive path without a real bell. 0 or unset disables. Only needed to rule out
# a listener hearing another client's local audio; the muted-clients test above
# already did that.
DSO_BELL_TEST_SECONDS=0

# --- server text -------------------------------------------------------------

# Pushed as the banner in the UPPER LEFT right after login. Empty disables it.
# This is NOT the Majula obelisk -- that text lives in the regulation archive.
DSO_MANAGEMENT_TEXT=
# 0 = Japanese, 1 = English.
DSO_MANAGEMENT_TEXT_LANGUAGE=1

# --- storage and logging -----------------------------------------------------

DSO_CRYPTO_KEY_DIR=data/keys
DSO_DATABASE_PATH=data/dso.db
DSO_LOGGING_LEVEL=debug

# Hexdumps every packet. Invaluable for protocol work, very noisy otherwise.
DSO_DEBUG_RAW=1

# --- regulation push (0x038B) -------------------------------------------------
#
# Replaces ONE whole resource file in the running client. No restart, no
# calibration download: the applier runs every frame and reloads the live
# resource in place. See tasks/regulation-push-038b.md.
#
# VERIFIED END TO END for params: this is what arms the Majula chest. The
# applier's repository and the chest's threshold reader are the same repository.
#
# Empty disables the push.
#
# The payload for a .param must be EXACTLY the same size as the resource it
# replaces or the client discards it without a word. Build one with:
#   python3 tools/calibration/calibration.py unpack \
#       data/calibrations/regulation_0114.bin /tmp/reg.bnd
#   python3 tools/gamedata/regparam.py extract /tmp/reg.bnd OnlineEventParam.param -o x.param
#   python3 tools/gamedata/regparam.py patch x.param --row 0 --offset 2 --u16 1 -o y.param
#
# data/regpush/armed/OnlineEventParam.param is exactly that: 0114's file with
# the Majula chest's claim threshold raised from 0 to 1; the untouched original
# is in data/regpush/stock/. Both keep the RESOURCE's file name, because the
# default `path` below is the payload's base name -- a file named
# OnlineEventParam.armed.param makes the client look up
# param:/OnlineEventParam.armed.param, find nothing, and discard the push in
# silence. That cost one live test.
DSO_REGULATION_PUSH_FILE=

# The `path` field: the key the client REGISTERED the resource under, which is a
# bare file name for both routes. Empty uses the payload's base name, which is
# right for params but NOT for the Majula obelisk -- its BND4 entry is
# regulationEnglish.fmg while the repository keys it as plain regulation.fmg.
# Read out of live memory at resource+4; see tasks/regulation-push-038b.md.
#
# DO NOT list speculative names here for a .fmg payload. A name that misses is
# harmless, but a name that HITS is memory corruption: the 1024-byte cap is a
# payload gate, not a destination gate, so the memcpy runs over whatever matched.
DSO_REGULATION_PUSH_PATH=

# Must equal the regulation version the client already holds, which is the game
# BUILD number -- 11500 for 1.15, read live from the holder at 0x1E1D388. Nothing
# in the protocol reports it. 0 also works, because the client skips the check
# when its own version is 0, but only while the holder has not been seeded.
DSO_REGULATION_PUSH_VERSION_REQUIRED=11500

# Becomes the client's new regulation version. Must be <= 999999. Empty or 0
# means "leave it where it is", which is what you want: the counter is compared
# against VERSION_REQUIRED on the next push, so incrementing walks it out of
# range after a few logins and everything stops with no error anywhere.
DSO_REGULATION_PUSH_VERSION_NEW=0

# Delay the push this many seconds after login. The applier reloads the resource
# immediately, but a consumer may only re-read its param when its object is
# registered at map load -- so a delay lets the push be timed against a
# deliberate area reload. 0 sends it at login.
DSO_REGULATION_PUSH_DELAY_SECONDS=0

# Seconds between consecutive resource pushes. NOT politeness: the applier
# accepts at most one entry per pass and then destroys the whole diff list, so
# two pushes arriving in the same frame means one is silently thrown away -- and
# a lost push is indistinguishable from a wrong path. Anything above one frame
# works; 2 leaves room for a loading hitch.
DSO_REGULATION_PUSH_GAP_SECONDS=2

# --- the Majula obelisk -------------------------------------------------------
#
# Replaces string id 100 of the regulation FMG, which the client registers as the
# bare resource "regulation.fmg". The server builds the whole FMG around this
# text, so there is no binary to edit. Empty leaves the stock line, "The letters
# are worn beyond recognition."
#
# "\n" starts a new line. The cap is 489 characters: the client's buffer for this
# resource is 1024 bytes and NEITHER apply route checks the payload against it,
# so overrunning corrupts the client rather than failing. Oversize is refused.
DSO_OBELISK_TEXT=

# Cell ids where a Bell Keeper trespasser can be summoned into, replacing the
# built-in set. Comma-separated.
#
# The built-in map is hand-built from play and is known incomplete, so it is a
# DIAGNOSTIC rather than a gate: an unmapped cell logs a warning naming the id
# and the request is served anyway. Watch for "bell keeper request from an
# unmapped cell" -- that is a cell to add here.
#
# Setting this does not restrict anything; it only changes which cells are
# considered already-known and so stay quiet in the log.
#
# This is NOT the bell-toll filter. Who HEARS a rung bell is DSO_BELL_REGION_
# <mapid>, which is a different filter on area ids rather than cell ids.
DSO_BELL_KEEPER_CELLS=
